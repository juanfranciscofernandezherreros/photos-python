# Copy this file to .env:  cp .env.example .env
# Then set PHOTOS_DIR to the host directory that will store the photo library.

# ── Photo library ───────────────────────────────────────────────────────────
# Use forward slashes ( / ), including on Windows.
# Examples:
#   PHOTOS_DIR=C:/Users/juanf/Pictures/PhotosSync
#   PHOTOS_DIR=D:/Fotos
#   PHOTOS_DIR=./photos
PHOTOS_DIR=C:/Users/juanf/Pictures/PhotosSync

# UID/GID used by the non-root application process. On Linux, use the output
# of `id -u` and `id -g` so the bind mount remains writable.
APP_UID=10001
APP_GID=10001

# ── PostgreSQL ──────────────────────────────────────────────────────────────
SECRETS_DIR=./secrets
# Generate the four required files with:
#   python scripts/generate_secrets.py

# ── Session signing secret ──────────────────────────────────────────────────
# The session key is read from secrets/app_secret_key.txt.

# ── Web dashboard ───────────────────────────────────────────────────────────
APP_PORT=8765
APP_BIND_IP=127.0.0.1
DB_BIND_IP=127.0.0.1
PGADMIN_BIND_IP=127.0.0.1
COOKIE_SECURE=false

# Public domain used by the optional Caddy HTTPS deployment.
PHOTOS_DOMAIN=photos.example.com

# ── Automated backups ───────────────────────────────────────────────────────
# Host directory for PostgreSQL dumps. Use forward slashes on Docker Desktop.
BACKUP_DIR=./backups
# Number of days to retain dumps.
BACKUP_KEEP_DAYS=7

# ── pgAdmin (optional) ──────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@photos-app.com

# ── Observability ("monitoring" profile) ───────────────────────────────────
# Services bind to localhost by default. Change passwords before first start.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=2GB
LOG_LEVEL=INFO
SERVICE_NAME=mi-api
LOG_RESPONSE_MAX_BYTES=16384

# Concurrent WebDAV ingestion. Start with 8; reduce to 3-4 if the phone or
# Wi-Fi becomes saturated. Partial files resume through HTTP Range requests.
WEBDAV_DOWNLOAD_WORKERS=8
WEBDAV_CHUNK_SIZE_KB=1024
# Number of capture records persisted per database write.
WEBDAV_DB_BATCH_SIZE=100
