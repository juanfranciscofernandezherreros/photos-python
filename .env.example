# Copia este fichero a .env:  cp .env.example .env
# Luego edita PHOTOS_DIR con la carpeta Windows donde quieras guardar las fotos.

# ── Donde se guardan las fotos ──────────────────────────────────────────────
# Usa barras normales ( / ), no backslashes ( \ ).
# Ejemplos:
#   PHOTOS_DIR=C:/Users/juanf/Pictures/PhotosSync
#   PHOTOS_DIR=D:/Fotos
#   PHOTOS_DIR=./photos
PHOTOS_DIR=C:/Users/juanf/Pictures/PhotosSync

# UID/GID usados por el proceso no-root del contenedor app. En Linux puedes
# poner el resultado de `id -u` e `id -g` para que el bind mount sea escribible.
APP_UID=10001
APP_GID=10001

# ── PostgreSQL ──────────────────────────────────────────────────────────────
SECRETS_DIR=./secrets
# Genera los cuatro archivos requeridos con:
#   python scripts/generate_secrets.py

# ── Clave secreta para firmar las sesiones de login ─────────────────────────
# La clave de sesion se lee desde secrets/app_secret_key.txt.

# ── Puerto del dashboard web ────────────────────────────────────────────────
APP_PORT=8765
APP_BIND_IP=127.0.0.1
DB_BIND_IP=127.0.0.1
PGADMIN_BIND_IP=127.0.0.1
COOKIE_SECURE=false

# ── Backups automáticos ─────────────────────────────────────────────────────
# Carpeta donde se guardan los dumps de PostgreSQL (en tu Windows si usas
# Docker Desktop, pon una ruta con barras normales).
BACKUP_DIR=./backups
# Cuántos días de dumps conservar (los más antiguos se borran solos).
BACKUP_KEEP_DAYS=7

# ── pgAdmin (opcional) ──────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@photos-app.com

# ── Observabilidad (perfil "monitoring") ───────────────────────────────────
# Solo escuchan en localhost. Cambia las contraseñas antes de arrancar.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=2GB
LOG_LEVEL=INFO
SERVICE_NAME=mi-api
LOG_RESPONSE_MAX_BYTES=16384

# Descarga WebDAV concurrente. Empieza con 6; reduce a 3-4 si el movil o la
# red Wi-Fi se saturan. El lote controla cuantas fotos se guardan por escritura.
WEBDAV_DOWNLOAD_WORKERS=6
WEBDAV_DB_BATCH_SIZE=100
